{
    "name": "ctw/ctw-middleware-htmlminifier",
    "description": "This PSR-15 middleware formats, fixes and beautifies the HTML in the Response body using a variety of adapters.",
    "license": "BSD-3-Clause",
    "type": "library",
    "require": {
        "php": "^8.5",
        "ext-tidy": "*",
        "ctw/ctw-middleware": "^5.0",
        "middlewares/utils": "^4.0.2",
        "psr/container": "^1.0 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0"
    },
    "require-dev": {
        "ctw/ctw-qa": "^6.0",
        "laminas/laminas-diactoros": "^3.0",
        "phpunit/phpunit": "^13.3",
        "symfony/var-dumper": "^8.0",
        "voku/html-min": "^4.5",
        "wyrihaximus/html-compress": "^4.4"
    },
    "suggest": {
        "voku/html-min": "Required by the WyriHaximus adapter, which minifies with WyriHaximus\\HtmlCompress.",
        "wyrihaximus/html-compress": "Required by the WyriHaximus adapter; without it only the simple and tidy adapters can be selected."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Ctw\\Middleware\\HtmlMinifierMiddleware\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CtwTest\\Middleware\\HtmlMinifierMiddleware\\": "test"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "composer-dependency-analyser": "php vendor/bin/composer-dependency-analyser",
        "ecs": "php vendor/bin/ecs --clear-cache",
        "ecs-fix": "php vendor/bin/ecs --clear-cache --fix",
        "phpstan": "bash vendor/ctw/ctw-qa/bin/phpstan.sh",
        "phpstan-baseline": "bash vendor/ctw/ctw-qa/bin/phpstan-baseline.sh",
        "qa": [
            "@composer-dependency-analyser",
            "@rector",
            "@ecs",
            "@phpstan"
        ],
        "qa-fix": [
            "@composer-dependency-analyser",
            "@rector-fix",
            "@ecs-fix",
            "@phpstan"
        ],
        "rector": "php vendor/bin/rector process --clear-cache --dry-run",
        "rector-fix": "php vendor/bin/rector process --clear-cache",
        "test": "export XDEBUG_MODE=coverage ; php vendor/bin/phpunit"
    }
}
